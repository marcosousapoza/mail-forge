MAILFORGE_IMAP_HOST=imap.example.com
MAILFORGE_IMAP_PORT=993
MAILFORGE_IMAP_TLS=true
MAILFORGE_SMTP_HOST=smtp.example.com
MAILFORGE_SMTP_PORT=587
MAILFORGE_SMTP_SECURITY=starttls
MAILFORGE_DEFAULT_FROM=user@example.com
MAILFORGE_CONNECTION_TIMEOUT=30
MAILFORGE_CACHE_ENABLED=true
MAILFORGE_CACHE_PATH=/var/cache/mailforge/cache.sqlite3
MAILFORGE_CACHE_MAX_MB=512
MAILFORGE_CACHE_EVICTION_DAYS=30
MAILFORGE_FLAGS_FRESHNESS_SECONDS=60
MAILFORGE_LOG_LEVEL=INFO
# Credential values belong in Podman secrets. These override their default paths.
MAILFORGE_IMAP_USERNAME_FILE=/run/secrets/mailforge_imap_username
MAILFORGE_IMAP_PASSWORD_FILE=/run/secrets/mailforge_imap_password
MAILFORGE_SMTP_USERNAME_FILE=/run/secrets/mailforge_smtp_username
MAILFORGE_SMTP_PASSWORD_FILE=/run/secrets/mailforge_smtp_password
